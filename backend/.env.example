# Copie para .env e preencha os valores do projeto Supabase.
DATABASE_URL=sqlite:///./comunidade.db
SUPABASE_DATABASE_URL=
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Somente no backend. Necessária para a equipe substituir imagens via painel.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_STORAGE_BUCKET=announcement-images
# Opcional: limite o acesso administrativo aos e-mails listados.
SUPABASE_ADMIN_EMAILS=
SUPABASE_JWT_SECRET=
UPLOAD_DIR=./uploads
SECRET_KEY=replace-with-a-long-random-secret
# Generate this with: python -m app.scripts.hash_password
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$REPLACE_ME
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
PII_HMAC_KEY=replace-with-a-different-long-random-secret
PRIVACY_NOTICE_VERSION=2026-08-17
